      "apply": { "model": "central_heater:block/ashtray_1_normal" }
    },
    {
      "when": { "ash_level": "2", "ash_type": "normal" },
      "apply": { "model": "central_heater:block/ashtray_2_normal" }
    },
    {
      "when": { "ash_level": "3", "ash_type": "normal" },
      "apply": { "model": "central_heater:block/ashtray_3_normal" }
    },
    {
      "when": { "ash_level": "4", "ash_type": "normal" },
      "apply": { "model": "central_heater:block/ashtray_4_normal" }
    },
    {
      "when": { "ash_level": "5", "ash_type": "normal" },
      "apply": { "model": "central_heater:block/ashtray_5_normal" }
    },
    {
